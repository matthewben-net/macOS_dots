#!/usr/bin/env bash

#╔══════════════════════════════╗
#║ ╭──────────────────────────╮ ║
#║ │          Colors          │ ║
#║ ╰──────────────────────────╯ ║
#╚══════════════════════════════╝

#╭────────────────╮
#│ Non-Bold Names │
#╰────────────────╯

flamingo="\e[38;2;242;205;205m"
muave_latte="\e[38;2;136;57;239m"
red="\e[38;2;243;139;168m"
peach="\e[38;2;250;179;135m"
green="\e[38;2;166;227;161m"
blue="\e[38;2;137;180;250m"

#╭────────────╮
#│ Bold Names │
#╰────────────╯

flamingo_b="\e[1;38;2;242;205;205m"
pink_b="\e[1;38;2;245;194;231m"
mauve_b="\e[1;38;2;203;166;247m"
red_b="\e[1;38;2;243;139;168m"
maroon_b="\e[1;38;2;235;160;172m"
peach_b="\e[1;38;2;250;179;135m"
green_b="\e[1;38;2;166;227;161m"
teal_b="\e[1;38;2;148;226;213m"
sapphire_b="\e[1;38;2;116;199;236m"
blue_b="\e[1;38;2;137;180;250m"
lavender_b="\e[1;38;2;180;190;254m"
printed_text_b="\e[1;38;2;255;255;255m"

#╭────────────────────╮
#│ Ascii Apple Colors │
#╰────────────────────╯

ac1=${red}
ac2=${green}
ac3=${peach}
ac4=${blue}
ac5=${flamingo}

#╭──────────────────────╮
#│ Traffic light colors │
#╰──────────────────────╯
tl1="\e[38;2;255;95;87m"
tl2="\e[38;2;254;188;46m"
tl3="\e[38;2;40;200;64m"

#╭──────╮
#│ Text │
#╰──────╯

tc0=${printed_text_b}
tc1=${lavender_b}
tc2=${teal_b}
tc3=${sapphire_b}
tc4=${maroon_b}
tc5=${peach_b}
tc6=${flamingo_b}
tc7=${pink_b}
tc8=${red_b}
tc9=${green_b}
tc10=${mauve_b}
tc11=${blue_b}

#╭─────────────────────────────────────╮
#│ Reset colors/format back to default │
#╰─────────────────────────────────────╯

reset_colors="\033[0m"
cr=${reset_colors}

#╭──────────────╮
#│ Border color │
#╰──────────────╯

# Function to convert the hex color into an ansi escape code
colprint() {
    hex="$1"
    r="${hex:0:2}"
    g="${hex:2:2}"
    b="${hex:4:2}"
   ansi_color=$(echo -en '\e[38;2;'$((16#$r))';'$((16#$g))';'$((16#$b))'m\n')
}

# Remove starting "0xff" alpha string from argb so we can get the regular 6 numbers
extract_standard_hex_numbers() {
	trimmed_color=${argb_hex_color//0xff/}
	standard_hex_num=${trimmed_color:(-6)}
}

# Check for jankyborder installation and set the border color to the first active color found
check_for_jankyborders() {
	jankyborders_service_status=$(brew services list | grep borders | awk '{ print $2}')
	bordersrc_file_path="$HOME/.config/borders/bordersrc"
	if which borders >/dev/null 2>&1; then
		if [ -f "$bordersrc_file_path" ]; then
			if [ "$jankyborders_service_status" = "started" ]; then
				# Search for the active_color line and extract the color
				active_color_line=$(grep 'active_color=' "$bordersrc_file_path" | head -n 1)
				if echo "$active_color_line" | grep -q "top_left"; then
					# Extract the color value between double quotes
					argb_hex_color=$(echo "$active_color_line" | sed 's/.*active_color="gradient(top_left=//; s/,.*//')
					extract_standard_hex_numbers
					colprint $standard_hex_num
					bc=${ansi_color}
				# Check if "top_right" is present in color_line
				elif echo "$active_color_line" | grep -q "top_right"; then
					argb_hex_color=$(echo "$active_color_line" | sed 's/.*active_color="gradient(top_right=//; s/,.*//')
					extract_standard_hex_numbers
					colprint $standard_hex_num
					bc=${ansi_color}
				elif echo "$active_color_line" | grep -q "glow"; then
					argb_hex_color=$(echo "$active_color_line" | sed 's/.*active_color="glow(\(.*\))"/\1/')
					extract_standard_hex_numbers
					colprint $standard_hex_num
					bc=${ansi_color}
				else
					argb_hex_color=$(echo "$active_color_line" | sed 's/.*\(0x[a-fA-F0-9]\{8\}\).*/\1/')
					extract_standard_hex_numbers
					colprint $standard_hex_num
					bc=${ansi_color}
				fi
			else
				bc=${muave_latte}
			fi
		else
			bc=${muave_latte}
		fi
	else
		bc=${muave_latte}
	fi
}

#╔═════════════════════════════════╗
#║ ╭─────────────────────────────╮ ║
#║ │          Functions          │ ║
#║ ╰─────────────────────────────╯ ║
#╚═════════════════════════════════╝

#╭──────────────────────────────────────────────────────╮
#│ Getting the username to fit within the window length │
#╰──────────────────────────────────────────────────────╯

get_username() {
	username=$USER
	max_username_length=14
	total_length=17
	# Check if username is longer than max_username_length
	if [ ${#username} -gt $max_username_length ]; then
		username="rxfetch"
	fi
	username_length=${#username}

	if [ ${#username} -gt $max_username_length ]; then
    		$username="rxfetch"
	fi

	spaces_num=$(( total_length - username_length - 1 ))
	printed_user="$(printf "%${spaces_num}s%s " '' "$username")"
}

#╭────────────────────────────────────────────────╮
#│ Getting the full distro name and build version │
#╰────────────────────────────────────────────────╯

get_distro_name() {
	NAME="macOS"
	nice_name=$(awk '/SOFTWARE LICENSE AGREEMENT FOR macOS/' '/System/Library/CoreServices/Setup Assistant.app/Contents/Resources/en.lproj/OSXSoftwareLicense.rtf' | awk -F 'macOS ' '{print $NF}' | awk '{print substr($0, 0, length($0)-1)}')
	ver=$(system_profiler SPSoftwareDataType | awk -F ': ' '/System Version/ {split($2, version, " \\("); printf "%s (%s)\n", version[1], substr(version[2], 1, length(version[2])-1)}' | awk '{$1=""; print $0}')
	architecture=$(uname -m)
	printed_distro=$(echo $NAME $nice_name $ver $architecture)
}

#╭──────────────────────────────────────────╮
#│ Getting the full kernel name and version │
#╰──────────────────────────────────────────╯

get_kernel() {
	kern=$(uname -s)
	kern_ver=$(uname -r)
	printed_kernel=$(echo $kern $kern_ver)
}

#╭───────────────────────────────────────────╮
#│ Getting the shell name (excluding /bin/*) │
#╰───────────────────────────────────────────╯

get_shell() {
	printed_shell=$(echo ${SHELL##*/})
}

#╭──────────────────────────────────────────────────────╮
#│ Getting the  terminal emulator (or multiplexer) used │
#╰──────────────────────────────────────────────────────╯

get_term() {
	case $TERM_PROGRAM in
		"Terminal.app" | "Apple_Terminal") printed_term="Apple Terminal";;
		"iTerm.app") printed_term="iTerm2";;
		*) printed_term="${TERM_PROGRAM%.app}";;
	esac
}

#╭────────────────────────────╮
#│ Getting the window manager │
#╰────────────────────────────╯

get_wm() {
	printed_wm="$(ps -e | grep -o \
		-e "[S]pectacle" \
		-e "[A]methyst" \
		-e "[k]wm" \
		-e "[c]hun[k]wm" \
		-e "[y]abai" \
		-e "[R]ectangle" | head -n1)"
}

#╭─────────────────────────────────────────────╮
#│ Getting the used memory out of total memory │
#╰─────────────────────────────────────────────╯

get_mem() {
	used_mem=$(ps -caxm -orss= | awk '{ sum += $1 } END { printf "%.2f", sum / (1024 * 1024) }')
	total_mem=$(($(sysctl -n hw.memsize) / 1024**3))
	printed_mem=$(printf "%.2fGB/%.2fGB\n" "$used_mem" "$total_mem")
}

#╭────────────────────────────────────────────────────────────────────────────────╮
#│ Getting the uptime formatted into days, hours, and minutes (taken from pfetch) │
#╰────────────────────────────────────────────────────────────────────────────────╯

get_uptime() {
	s=$(sysctl -n kern.boottime)

	# Extract the uptime in seconds from the following output:
        # [...] { sec = 1271934886, usec = 667779 } Thu Apr 22 12:14:46 2010
	s=${s#*=}
	s=${s%,*}

        # The uptime format from 'sysctl' needs to be subtracted from
        # the current time in seconds.
        s=$(($(date +%s) - s))

	# Convert the uptime from seconds into days, hours and minutes.
	d=$((s / 60 / 60 / 24))
	h=$((s / 60 / 60 % 24))
	m=$((s / 60 % 60))

	# Only append days, hours and minutes if they're non-zero.
	[ "$d" = 0 ] || uptime="${uptime}${d}d "
	[ "$h" = 0 ] || uptime="${uptime}${h}h "
	[ "$m" = 0 ] || uptime="${uptime}${m}m "

	printed_up=$(echo "${uptime:-0m}")
}

#╔═════════════════════════════════════════════════════════════════════════════╗
#║ ╭─────────────────────────────────────────────────────────────────────────╮ ║
#║ │          Running all of the functions first. The brew function          │ ║
#║ │          would make the fetch pause while fetching the info.            │ ║
#║ │          By saving every function output to a variable,                 │ ║
#║ │          the actual fetch printing can be executed quickly.             │ ║
#║ ╰─────────────────────────────────────────────────────────────────────────╯ ║
#╚═════════════════════════════════════════════════════════════════════════════╝

check_for_jankyborders
get_username
get_distro_name
get_kernel
get_shell
get_term
get_wm
get_mem
get_uptime

#╔═════════════════════════════════════════════════╗
#║ ╭─────────────────────────────────────────────╮ ║
#║ │          Printing the actual fetch          │ ║
#║ ╰─────────────────────────────────────────────╯ ║
#╚═════════════════════════════════════════════════╝

echo -e "   ${bc}╭───────────────────────╮"
echo -e "   ${bc}│ ${tl1}● ${tl2}● ${tl3}●${tc1}${printed_user}${bc}│"
echo -e "   ${bc}├────────┬──────────────┤"
echo -e "   ${bc}│ ${tc3} os   ${bc}│       ${ac1}.:'    ${bc}│  ${tc0}${printed_distro}"
echo -e "   ${bc}│ ${tc4} ker  ${bc}│    ${ac1}_ :'_     ${bc}│  ${tc0}${printed_kernel}"
echo -e "   ${bc}│ ${tc5} sh   ${bc}│  ${ac2}.'\`_\`-'_\`\`. ${bc}│  ${tc0}${printed_shell}"
echo -e "   ${bc}│ ${tc6} term ${bc}│ ${ac2}:________.-' ${bc}│  ${tc0}${printed_term}"
echo -e "   ${bc}│ ${tc7} wm   ${bc}│ ${ac3}:_______:    ${bc}│  ${tc0}${printed_wm}"
echo -e "   ${bc}│ ${tc9} ram  ${bc}│  ${ac4}:_______\`-; ${bc}│  ${tc0}${printed_mem}"
echo -e "   ${bc}│ ${tc10} up   ${bc}│   ${ac5}\`._.-._.'  ${bc}│  ${tc0}${printed_up}"
echo -e "   ${bc}├────────┴──────────────┤"
echo -e "   ${bc}│       ${tc11} colors        ${bc}│  ${tc3}⬤  ${tc9}⬤  ${tc11}⬤  ${tc8}⬤  ${tc5}⬤  ${tc10}⬤  ${tc4}⬤  ${tc1}⬤  ${bc}⬤ "
echo -e "   ${bc}╰───────────────────────╯${cr}"
